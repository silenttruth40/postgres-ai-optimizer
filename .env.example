# ========================================================
# PostgreSQL AI Optimizer - Environment Configuration
# Problem Statement 4: Zero-Data Privacy & AI Optimization
# ========================================================

# Primary / Production Demo Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=optimizer
POSTGRES_USER=optimizer
POSTGRES_PASSWORD=optimizer

# Sandbox PostgreSQL Database (Isolated Simulation Instance)
SANDBOX_POSTGRES_HOST=localhost
SANDBOX_POSTGRES_PORT=5433
SANDBOX_POSTGRES_DB=optimizer_sandbox
SANDBOX_POSTGRES_USER=optimizer
SANDBOX_POSTGRES_PASSWORD=optimizer

# Backend FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Streamlit Dashboard Configuration
STREAMLIT_PORT=8501

# Dataset Configuration (tiny | small | medium | large)
DEMO_SCALE=medium
DEMO_SEED=42

# Sandbox Simulation Settings
BENCHMARK_TIMEOUT_SECONDS=90
BENCHMARK_REPEAT=1

# ========================================================
# Google Gemini AI Integration (Privacy-Preserving)
# ========================================================
# Paste your Google Gemini API Key below.
# Zero raw data or company PII is ever sent to Gemini:
# All queries, plans, tables, and columns are bitmasked
# and hashed into tokens before being explained.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# (Optional fallback) OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
