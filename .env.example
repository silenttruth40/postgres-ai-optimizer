STREAMLIT_PORT=8501

# tiny | small | medium | large
DEMO_SCALE=medium
DEMO_SEED=42
BENCHMARK_TIMEOUT_SECONDS=90
BENCHMARK_REPEAT=1

# Optional. Leave empty to use the local explanation engine.
# Never send raw SQL literals or PII to an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
